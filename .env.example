FLASK_APP=run.py
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-value
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pizzaria_picon
MYSQL_USER=pizzaria_app
MYSQL_PASSWORD=replace-with-a-local-secret
# Only needed when the database does not exist yet; keep this account separate.
MYSQL_PROVISION_USER=
MYSQL_PROVISION_PASSWORD=
# Optional: DATABASE_URL takes precedence over MYSQL_* settings.
COOKIE_SECURE=0
STORE_NAME=Bella Pizza
